            "description": "Searches the DigitalNZ corpus (30M+ items from NZ libraries, archives, museums, media).\n\nDocs: https://digitalnz.org/developers/api-docs-v3 · OpenAPI: https://app.swaggerhub.com/apis-docs/DigitalNZ/Records/3"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let j={};try{j=pm.response.json();}catch(e){}",
                  "const s=j.search||{};",
                  "const rows=(s.results||[]).map(r=>[`<a href=\"${r.source_url||r.landing_url||''}\">${(r.title||'').slice(0,140)}</a>`,r.display_date||'',r.display_collection||'',[].concat(r.category||[]).join(', '),r.content_partner&&[].concat(r.content_partner).join(', ')||'',r.id]);",
